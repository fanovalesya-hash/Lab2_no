<Window x:Class="Lab2_no.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab2_no"
        mc:Ignorable="d"
        Title="Авторизатция" Height="168" Width="250">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Логин:" VerticalAlignment="Center" 
                   Margin="0,0,10,10" Grid.Row="0" Grid.Column="0"/>
        <TextBox x:Name="LoginTextBox" VerticalAlignment="Center" 
                 Margin="0,0,0,10" Grid.Row="0" Grid.Column="1"/>

        <TextBlock Text="Пароль:" VerticalAlignment="Center"
                   Margin="0,0,10,10" Grid.Row="1" Grid.Column="0"/>
        <PasswordBox x:Name="PasswordBox" VerticalAlignment="Center"
                     Margin="0,0,0,10" Grid.Row="1" Grid.Column="1"/>

        <Button Content="Войти" Width="100" Height="30" 
                Click="Loggin_Button_Click"  Grid.Row="2" Grid.Column="1" 
                HorizontalAlignment="Right" Margin="0,10,0,0"/>

        <TextBlock x:Name="ErrorTextBlock" Foreground="Red" 
                   Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" 
                   HorizontalAlignment="Center" Margin="0,10,0,0"/>
    </Grid>
</Window>
