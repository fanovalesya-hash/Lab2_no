<Window x:Class="Lab2_no.ManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab2_no"
        mc:Ignorable="d"
        Title="ManagerWindow" Height="450" Width="800">
    <Grid>
        <TextBlock x:Name="WelcomeText" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Button Content="Выйти" Grid.Row="1" Width="120" Height="35" 
            Click="Button_Click" VerticalAlignment="Top" HorizontalAlignment="Right"/>
    </Grid>
</Window>
